<Window x:Class="AgentJeff.VoiceCompanionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JT Desktop Agent · Voice Companion" Width="440" Height="430" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Background="#080914" Foreground="#F4F3FF">
  <Border BorderBrush="#625A91" BorderThickness="1" CornerRadius="22" Padding="22" Background="#111224">
    <Border.Effect><DropShadowEffect Color="#8277FF" BlurRadius="34" ShadowDepth="0" Opacity=".3"/></Border.Effect>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border Width="38" Height="38" CornerRadius="11" Background="#20213B" BorderBrush="#746DAB" BorderThickness="1"><TextBlock Text="JT" Foreground="#C9C4FF" FontSize="18" FontWeight="Black" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="J TECH DIGITAL WORLD" FontSize="9" FontWeight="Bold" Foreground="#F7F5FF"/><TextBlock Text="JEFF · DESKTOP COMPANION" FontSize="8" Foreground="#9B9BB8" Margin="0,4,0,0"/></StackPanel>
        <Button Content="×" Click="Hide_Click" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" Background="#24243C" FontSize="17"/>
      </DockPanel>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
        <Grid Width="126" Height="126" HorizontalAlignment="Center" Margin="0,0,0,18"><Ellipse Stroke="#37365D" StrokeThickness="1"/><Ellipse Margin="12" Stroke="#6C65A8" StrokeThickness="1"/><Ellipse Margin="30" Fill="#9690FF"><Ellipse.Effect><DropShadowEffect Color="#9690FF" BlurRadius="28" ShadowDepth="0" Opacity=".65"/></Ellipse.Effect></Ellipse><TextBlock Text="JT" FontSize="30" FontWeight="Black" FontStyle="Italic" Foreground="#101122" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <TextBlock Text="Ready when you are." FontSize="23" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Text="Your desktop companion from JT Digital World. Voice listening stays off until you start it." Foreground="#A5A6C0" TextWrapping="Wrap" TextAlignment="Center" Margin="8,10,8,0" LineHeight="21"/>
        <Border Background="#302719" BorderBrush="#66502D" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,15,0,0"><TextBlock Text="Wake-word detection and speaker verification are not enabled in this build." Foreground="#FFD38A" TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/></Border>
      </StackPanel>
      <Button Grid.Row="2" Content="STOP &amp; HIDE COMPANION" Click="Hide_Click" Height="42" Background="#9690FF" Foreground="#101122" BorderThickness="0"/>
    </Grid>
  </Border>
</Window>
<Window x:Class="AgentJeff.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JT Desktop Agent · J Tech Digital World" Height="900" Width="1440" MinHeight="760" MinWidth="1050" Background="#080914" Foreground="#F4F3FF" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <LinearGradientBrush x:Key="JTAccent" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#78E5DF"/><GradientStop Color="#9690FF" Offset="0.55"/><GradientStop Color="#C4A2FF" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F7F6FF"/><Setter Property="Background" Value="#24243C"/><Setter Property="BorderBrush" Value="#494365"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#A69BFF"/><Setter TargetName="bd" Property="Background" Value="#34304F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C0D1B"/><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="CaretBrush" Value="#9E96FF"/><Setter Property="BorderBrush" Value="#34334F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#17172A"/><Setter Property="Foreground" Value="#18182A"/><Setter Property="BorderBrush" Value="#45415F"/><Setter Property="Padding" Value="8"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#E6080A16" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
      <DockPanel Margin="42,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
          <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource JTAccent}" Padding="1"><Border CornerRadius="12" Background="#0D1020"><TextBlock Text="JT" FontSize="21" FontWeight="Black" FontStyle="Italic" Foreground="#DDFBFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="J TECH DIGITAL WORLD" FontSize="12" FontWeight="ExtraBold" Foreground="#F7F5FF"/><TextBlock Text="JT DESKTOP AGENT" FontSize="9" Foreground="#8D8DAE" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="#132B2929" BorderBrush="#315D594B" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="READY · MICROPHONE OFF" Foreground="#83E5C8" FontSize="10" FontWeight="Bold"/></Border>
          <Button Content="Open Security Center" Click="OpenSecurity_Click" Padding="14,9"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid Margin="64,54,64,36">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.04*"/><ColumnDefinition Width="0.96*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,45,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#78E5DF" Margin="0,0,9,0"/><TextBlock Text="YOUR DESKTOP. YOUR COMMAND." Foreground="#A8A0FF" FontSize="10" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="Meet Jeff.&#10;Make more happen." FontSize="48" FontWeight="ExtraBold" LineHeight="55" Foreground="#FAF9FF" Margin="0,22,0,16"/>
            <TextBlock Text="A smarter desktop companion from JT Digital World. Use voice, review your work, and stay in control of every permission." Foreground="#A9AAC4" FontSize="15" TextWrapping="Wrap" LineHeight="25" MaxWidth="560"/>
            <WrapPanel Margin="0,26,0,0"><Button x:Name="ListenButton" Content="Start voice input" Click="Listen_Click" Background="{StaticResource JTAccent}" Foreground="#101122" BorderThickness="0" Padding="20,13"/><Button Content="Show floating Jeff" Click="ShowCompanion_Click" Margin="10,0,0,0" Padding="20,13"/></WrapPanel>
            <TextBlock Text="MICROPHONE IS OFF UNTIL YOU START IT · YOU CAN STOP AT ANY TIME" Foreground="#777994" FontSize="9" FontWeight="Bold" Margin="0,20,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" CornerRadius="22" BorderBrush="#514A7B" BorderThickness="1" Background="#121326" Padding="22">
            <Border.Effect><DropShadowEffect Color="#756BFF" BlurRadius="42" ShadowDepth="0" Opacity=".17"/></Border.Effect>
            <StackPanel>
              <DockPanel><TextBlock Text="JEFF AI · DESKTOP COMPANION" FontSize="10" FontWeight="Bold" Foreground="#A9A1FF"/><Border DockPanel.Dock="Right" Background="#172D2A" CornerRadius="7" Padding="8,5"><TextBlock Text="LOCAL SESSION" Foreground="#82E4C7" FontSize="8" FontWeight="Bold"/></Border></DockPanel>
              <Grid Height="170" Margin="0,15,0,10">
                <Ellipse Width="150" Height="150" Stroke="#34345A" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="120" Height="120" Stroke="#6660A4" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".7"/>
                <Ellipse Width="88" Height="88" Fill="{StaticResource JTAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Effect><DropShadowEffect Color="#9B91FF" BlurRadius="35" ShadowDepth="0" Opacity=".6"/></Ellipse.Effect></Ellipse>
                <TextBlock Text="JT" FontSize="29" FontWeight="Black" FontStyle="Italic" Foreground="#101224" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="Ready when you are." FontSize="23" FontWeight="Bold" Foreground="#F7F5FF" HorizontalAlignment="Center"/>
              <TextBlock Text="Your assistant is ready. Voice capture remains off until you choose to start." Foreground="#999BB8" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="12,7,12,18"/>
              <UniformGrid Columns="2" Rows="2">
                <Border Background="#1A1A30" CornerRadius="10" Padding="12" Margin="4"><StackPanel><TextBlock Text="VOICE INPUT" Foreground="#A8A0FF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Manual &amp; visible" Foreground="#E8E6F6" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="#1A1A30" CornerRadius="10" Padding="12" Margin="4"><StackPanel><TextBlock Text="PRIVACY" Foreground="#7DE0C5" FontSize="9" FontWeight="Bold"/><TextBlock Text="User controlled" Foreground="#E8E6F6" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="#1A1A30" CornerRadius="10" Padding="12" Margin="4"><StackPanel><TextBlock Text="COMPANION" Foreground="#D4A5FF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Floating panel" Foreground="#E8E6F6" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="#1A1A30" CornerRadius="10" Padding="12" Margin="4"><StackPanel><TextBlock Text="JT ECOSYSTEM" Foreground="#8DC7FF" FontSize="9" FontWeight="Bold"/><TextBlock Text="App links planned" Foreground="#E8E6F6" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Border>
        </Grid>
        <Border Background="#0D0E1D" Padding="64,32" BorderBrush="#1EFFFFFF" BorderThickness="0,1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="YOUR WORKSPACE" Foreground="#A8A0FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="Talk. Review. Take action." Foreground="#F7F5FF" FontSize="25" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="Speech tools and assistant controls available in this build." Foreground="#999BB8" FontSize="11" Margin="0,8,20,0" TextWrapping="Wrap"/></StackPanel>
            <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
              <Border Background="#141528" BorderBrush="#35324F" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,9,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel><TextBlock Text="VOICE INPUT" Foreground="#A8A0FF" FontSize="10" FontWeight="Bold"/><TextBlock Text="Speak and review your words" Foreground="#F7F5FF" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                  <TextBox x:Name="TranscriptBox" Grid.Row="1" Margin="0,14,0,14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" MinHeight="125" Text="Your recognized speech will appear here. Review it before using it."/>
                  <WrapPanel Grid.Row="2"><Button Content="Stop" Click="Stop_Click"/><Button Content="Clear" Click="Clear_Click" Margin="8,0,0,0"/></WrapPanel>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1">
                <Border Background="#141528" BorderBrush="#35324F" BorderThickness="1" CornerRadius="15" Padding="16">
                  <StackPanel><TextBlock Text="VOICE PROFILE" Foreground="#A8A0FF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Choose Jeff's voice" Foreground="#F7F5FF" FontSize="15" FontWeight="Bold" Margin="0,6,0,10"/><ComboBox x:Name="VoicePicker" Height="34" SelectionChanged="VoicePicker_SelectionChanged"/><Button Content="Preview voice" Click="PreviewVoice_Click" Margin="0,9,0,0"/></StackPanel>
                </Border>
                <Border Background="#141528" BorderBrush="#35324F" BorderThickness="1" CornerRadius="15" Padding="16" Margin="0,10,0,0">
                  <StackPanel><TextBlock Text="SPEAK TEXT" Foreground="#7DE0C5" FontSize="9" FontWeight="Bold"/><TextBlock Text="Listen to reviewed text" Foreground="#F7F5FF" FontSize="14" FontWeight="Bold" Margin="0,6,0,10"/><Button Content="Speak transcript" Click="SpeakTranscript_Click"/><Button Content="Stop speaking" Click="StopSpeaking_Click" Margin="0,8,0,0"/></StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <TextBlock Text="JT DESKTOP AGENT  ·  J TECH DIGITAL WORLD     •     Privacy: microphone use is user-started. This build does not record audio in the background or implement wake-word listening." Foreground="#747792" FontSize="9" TextWrapping="Wrap" Margin="64,22,64,28"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
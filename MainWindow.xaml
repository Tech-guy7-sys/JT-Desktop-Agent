<Window x:Class="AgentJeff.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JT Desktop Agent · Jeff AI" Height="900" Width="1480" MinHeight="760" MinWidth="1120" Background="#F5F6FA" Foreground="#202432" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#202432"/><SolidColorBrush x:Key="Muted" Color="#737B8C"/><SolidColorBrush x:Key="Line" Color="#E5E8EF"/><SolidColorBrush x:Key="Violet" Color="#6258D6"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#34394A"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#DDE1EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#A9A3EA"/><Setter TargetName="bd" Property="Background" Value="#F7F6FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FBFCFE"/><Setter Property="Foreground" Value="#252A38"/><Setter Property="CaretBrush" Value="#6258D6"/><Setter Property="BorderBrush" Value="#DDE1EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#252A38"/><Setter Property="BorderBrush" Value="#DDE1EA"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#687184"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="7,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tab" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tab" Property="Background" Value="#ECEBFA"/><Setter Property="Foreground" Value="#5148C3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tab" Property="Background" Value="#F0F1F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="0,0,0,1">
      <Grid Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="35" Height="35" CornerRadius="9" Background="#25283A"><TextBlock Text="JT" Foreground="#FFFFFF" FontWeight="Black" FontStyle="Italic" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="JT DESKTOP AGENT" FontSize="11" FontWeight="ExtraBold" Foreground="#202432"/><TextBlock Text="J TECH DIGITAL WORLD" FontSize="9" Foreground="#8A91A0" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <TextBlock Grid.Column="1" Text="Your desktop command centre" Foreground="#747C8D" FontSize="12" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#F1F8F5" BorderBrush="#D9EEE5" BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="0,0,10,0"><TextBlock x:Name="StatusText" Text="READY · MICROPHONE OFF" Foreground="#247C5D" FontSize="10" FontWeight="Bold"/></Border><Button Content="Security Center" Click="OpenSecurity_Click" Padding="13,9"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <TabControl x:Name="ContentTabs" TabStripPlacement="Left" SelectedIndex="0" Background="Transparent" BorderThickness="0">
        <TabControl.Resources>
          <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="0,0,1,0"><DockPanel Margin="14,18"><TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Foreground="#9AA1AE" FontSize="9" FontWeight="Bold" Margin="10,9,0,12"/><TabPanel IsItemsHost="True" Background="Transparent"/><StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,8"><Border Height="1" Background="#E8EAF0" Margin="0,0,0,13"/><TextBlock Text="CONTROL &amp; PRIVACY" Foreground="#9AA1AE" FontSize="9" FontWeight="Bold" Margin="8,0,0,9"/><Border Background="#F7F8FB" CornerRadius="9" Padding="11"><StackPanel><TextBlock Text="Microphone" Foreground="#7A8292" FontSize="10"/><TextBlock Text="Off until you start it" Foreground="#303748" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><TextBlock Text="Desktop actions require approval. No background voice capture is active." TextWrapping="Wrap" Foreground="#9299A7" FontSize="9" Margin="8,10,8,0"/></StackPanel></DockPanel></Border><Border Grid.Column="1" Background="#F5F6FA" Padding="27,22"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
        </TabControl.Resources>
        <TabItem Header="Overview">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1160" HorizontalAlignment="Left">
            <TextBlock Text="DESKTOP OVERVIEW" Foreground="#6258D6" FontSize="10" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock Text="Good to have you here." Foreground="#202432" FontSize="31" FontWeight="Bold"/>
            <TextBlock Text="Jeff AI is ready to help you work through desktop tasks with clear controls and visible permissions." Foreground="#788091" FontSize="13" Margin="0,8,0,22"/>
            <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#FFFFFF" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="JEFF AI · ASSISTANT" Foreground="#6258D6" FontSize="9" FontWeight="Bold"/><TextBlock Text="Voice, review and act." Foreground="#242938" FontSize="22" FontWeight="Bold" Margin="0,9,0,7"/><TextBlock Text="Start voice input when you are ready. You can stop listening at any time." Foreground="#7B8392" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,17"/><WrapPanel><Button x:Name="ListenButton" Content="Start voice input" Click="Listen_Click" Background="#6258D6" Foreground="#FFFFFF" BorderBrush="#6258D6" Padding="18,12"/><Button Content="Open floating companion" Click="ShowCompanion_Click" Margin="9,0,0,0"/></WrapPanel></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#F0F2F8" CornerRadius="13" Padding="20"><StackPanel><TextBlock Text="SESSION STATUS" Foreground="#777F90" FontSize="9" FontWeight="Bold"/><TextBlock Text="Local desktop session" Foreground="#222838" FontSize="17" FontWeight="Bold" Margin="0,8,0,4"/><TextBlock Text="Voice recognition is manual. No wake-word or background recording is enabled." Foreground="#737C8D" FontSize="11" TextWrapping="Wrap"/><Border Background="#FFFFFF" CornerRadius="8" Padding="10" Margin="0,15,0,0"><TextBlock Text="●   Privacy controls active" Foreground="#277B5D" FontSize="10" FontWeight="Bold"/></Border></StackPanel></Border>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,9,0"><StackPanel><TextBlock Text="01  VOICE" Foreground="#6258D6" FontSize="9" FontWeight="Bold"/><TextBlock Text="Speech workspace" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="Transcribe, review and speak selected text." Foreground="#7D8593" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
              <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="5,0,5,0"><StackPanel><TextBlock Text="02  SECURITY" Foreground="#277F61" FontSize="9" FontWeight="Bold"/><TextBlock Text="Protection centre" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="Inspect Windows security status and request approved scans." Foreground="#7D8593" FontSize="10" TextWrapping="Wrap"/><Button Content="Open security" Click="OpenSecurity_Click" HorizontalAlignment="Left" Margin="0,11,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="9,0,0,0"><StackPanel><TextBlock Text="03  FILE REVIEW" Foreground="#8B6BCE" FontSize="9" FontWeight="Bold"/><TextBlock Text="Local file triage" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="Inspect file metadata and SHA-256 locally. Results are not a malware verdict." Foreground="#7D8593" FontSize="10" TextWrapping="Wrap"/><Button Content="Review a file" Click="ReviewFile_Click" HorizontalAlignment="Left" Margin="0,11,0,0"/></StackPanel></Border>
            </Grid>
            <TextBlock Text="TASK APPROVAL" Foreground="#6258D6" FontSize="9" FontWeight="Bold" Margin="0,25,0,9"/>
            <Border Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="No desktop task is currently running." Foreground="#2C3343" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Future automation actions must show the requested action, target and permission scope before execution. This overview does not claim desktop automation is connected." Foreground="#7D8593" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Voice & transcript">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#FFFFFF" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,8,12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="VOICE WORKSPACE" Foreground="#6258D6" FontSize="9" FontWeight="Bold"/><TextBlock Text="Speak and review your words" Foreground="#242938" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel><TextBox x:Name="TranscriptBox" Grid.Row="1" Margin="0,16" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" MinHeight="200" Text="Your recognized speech will appear here. Review it before using it."/><WrapPanel Grid.Row="2"><Button Content="Stop listening" Click="Stop_Click"/><Button Content="Clear transcript" Click="Clear_Click" Margin="8,0,0,0"/><Button Content="Review a file" Click="ReviewFile_Click" Margin="8,0,0,0"/></WrapPanel></Grid></Border>
            <StackPanel Grid.Column="1" Margin="12,8,0,8">
              <Border Background="#FFFFFF" BorderBrush="#E4E7EF" BorderThickness="1" CornerRadius="13" Padding="18"><StackPanel><TextBlock Text="VOICE PROFILE" Foreground="#6258D6" FontSize="9" FontWeight="Bold"/><TextBlock Text="Choose Jeff's voice" Foreground="#242938" FontSize="16" FontWeight="Bold" Margin="0,7,0,12"/><ComboBox x:Name="VoicePicker" Height="36" SelectionChanged="VoicePicker_SelectionChanged"/><Button Content="Preview voice" Click="PreviewVoice_Click" Margin="0,10,0,0"/><Button Content="Speak transcript" Click="SpeakTranscript_Click" Margin="0,8,0,0" Background="#6258D6" Foreground="#FFFFFF" BorderBrush="#6258D6"/><Button Content="Stop speaking" Click="StopSpeaking_Click" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Background="#F0F2F8" CornerRadius="13" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="MICROPHONE PRIVACY" Foreground="#277B5D" FontSize="9" FontWeight="Bold"/><TextBlock Text="You control capture." Foreground="#252B3A" FontSize="16" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock Text="Recognition starts only when you press Start voice input. The Stop control ends the session." Foreground="#747D8D" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Quick actions">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,8"><TextBlock Text="QUICK ACTIONS" Foreground="#6258D6" FontSize="9" FontWeight="Bold"/><TextBlock Text="Choose a task to open." Foreground="#222838" FontSize="25" FontWeight="Bold" Margin="0,8,0,17"/><UniformGrid Columns="2" Rows="2">
            <Border Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,10,10"><StackPanel><TextBlock Text="SECURITY" Foreground="#277B5D" FontSize="9" FontWeight="Bold"/><TextBlock Text="Windows protection" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7"/><Button Content="Open Security Center" Click="OpenSecurity_Click" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="19" Margin="5,0,0,10"><StackPanel><TextBlock Text="COMPANION" Foreground="#6258D6" FontSize="9" FontWeight="Bold"/><TextBlock Text="Floating Jeff" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7"/><Button Content="Show companion" Click="ShowCompanion_Click" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,5,10,0"><StackPanel><TextBlock Text="FILE REVIEW" Foreground="#8B6BCE" FontSize="9" FontWeight="Bold"/><TextBlock Text="Local file triage" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7"/><Button Content="Choose a file" Click="ReviewFile_Click" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Background="#FFFFFF" BorderBrush="#E5E8EF" BorderThickness="1" CornerRadius="12" Padding="19" Margin="5,5,0,0"><StackPanel><TextBlock Text="VOICE" Foreground="#C17D48" FontSize="9" FontWeight="Bold"/><TextBlock Text="Speech workspace" Foreground="#252B3A" FontSize="15" FontWeight="Bold" Margin="0,7"/><Button Content="Open voice tools" Click="Listen_Click" HorizontalAlignment="Left"/></StackPanel></Border>
          </UniformGrid><TextBlock Text="No action runs in the background. Each available action is started explicitly by you." Foreground="#838B99" FontSize="10" Margin="0,15,0,0"/></StackPanel>
        </TabItem>
      
      </TabControl>
    </Grid>  </Grid>
</Window>